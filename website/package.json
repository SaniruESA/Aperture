{
  "name": "aperture",
  "version": "1.0.0",
  "description": "Electron Aperture Integration",
  "license": "ISC",
  "author": "Aperture Developers",
  "type": "commonjs",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "extraResources": [
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "..\\code_modification",
        "to": "code_modification",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "..\\lib_build",
        "to": "lib_build",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "..\\build\\python_deps",
        "to": "py_deps",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
