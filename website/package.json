{
  "name": "aperture",
  "version": "1.0.0",
  "description": "Electron Aperture Integration",
  "license": "ISC",
  "author": "Aperture Developers",
  "type": "commonjs",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "electron": "^39.8.3",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.aperture.app",
    "productName": "Aperture",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "files": [
      "src/**/*",
      "pages/**/*",
      "index.html"
    ],
    "extraResources": [
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../code_modification",
        "to": "code_modification",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "lib_build/macOS",
        "to": "lib_build",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
