<Window
    x:Class="TSA_Working_Name.InitWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="Black">
        <!-- Small static black subtitle window -->
        <Border x:Name="SubtitleContainer"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="25"
                Background="Black">
            <TextBlock x:Name="SubtitleOverlay"
                       Text="(Waiting for audio events...)"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="8" />
        </Border>
    </Grid>
</Window>
